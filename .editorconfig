# Editor settings that match rustfmt.toml and .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# YAML and Markdown are conventionally indented by two spaces.
[*.{yml,yaml,md}]
indent_size = 2

# Keep in sync with the *.ps1 rule in .gitattributes.
[*.ps1]
end_of_line = crlf
